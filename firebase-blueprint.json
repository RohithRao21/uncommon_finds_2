{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profiles and customer metadata",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier of the user"
        },
        "fullName": {
          "type": "string",
          "description": "Full name of the customer"
        },
        "email": {
          "type": "string",
          "description": "Primary email address"
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of registration"
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether the user's email has been verified"
        },
        "role": {
          "type": "string",
          "description": "User account role, defaults to customer"
        }
      },
      "required": ["uid", "fullName", "email", "createdAt", "role"]
    },
    "orders": {
      "title": "Orders",
      "description": "Customer print orders",
      "type": "object",
      "properties": {
        "orderNumber": {
          "type": "string",
          "description": "Human readable order number like UF100001"
        },
        "userId": {
          "type": "string",
          "description": "UID of the user who placed the order"
        },
        "userEmail": {
          "type": "string",
          "description": "Email of the customer"
        },
        "userName": {
          "type": "string",
          "description": "Full name of the customer"
        },
        "items": {
          "type": "array",
          "description": "Cart items in the order"
        },
        "shippingAddress": {
          "type": "object",
          "description": "Shipping address details for the order"
        },
        "subtotal": {
          "type": "number",
          "description": "Subtotal amount in INR"
        },
        "shipping": {
          "type": "number",
          "description": "Shipping fee in INR"
        },
        "tax": {
          "type": "number",
          "description": "GST tax amount in INR"
        },
        "total": {
          "type": "number",
          "description": "Grand total amount in INR"
        },
        "paymentStatus": {
          "type": "string",
          "description": "Payment status, e.g. Pending, Paid"
        },
        "orderStatus": {
          "type": "string",
          "description": "Order status, e.g. Pending, Processing, Printing, Shipped, Delivered"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Order creation timestamp"
        }
      },
      "required": ["orderNumber", "items", "subtotal", "shipping", "tax", "total", "paymentStatus", "orderStatus"]
    },
    "products": {
      "title": "Products",
      "description": "Catalog of 3D-printed products with multi-color stock and image galleries",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product identifier"
        },
        "name": {
          "type": "string",
          "description": "Product display name"
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly slug identifier"
        },
        "description": {
          "type": "string",
          "description": "Detailed product description"
        },
        "price": {
          "type": "number",
          "description": "Product base price in INR"
        },
        "category": {
          "type": "string",
          "description": "Product category (lighter, desk, edc, audio, parametric)"
        },
        "colors": {
          "type": "array",
          "description": "List of available color variants, stock count, and color-specific images",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "stock": { "type": "number" },
              "images": {
                "type": "array",
                "items": { "type": "string" }
              },
              "hexColor": { "type": "string" }
            },
            "required": ["name", "stock", "images"]
          }
        }
      },
      "required": ["name", "slug", "description", "price", "category", "colors"]
    },
    "cartItems": {
      "title": "Cart Items",
      "description": "User shopping cart items in user cart subcollection",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "selectedColor": { "type": "string" },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "image": { "type": "string" }
      },
      "required": ["productId", "productName", "selectedColor", "quantity", "price", "image"]
    },
    "wishlistItems": {
      "title": "Wishlist Items",
      "description": "User wishlist saved products in user wishlist subcollection",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "description": "ID of the wishlisted product" },
        "addedAt": { "type": "string", "format": "date-time", "description": "ISO timestamp when item was added to wishlist" }
      },
      "required": ["productId", "addedAt"]
    },
    "addresses": {
      "title": "Addresses",
      "description": "Saved customer addresses in user addresses subcollection",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "addressLine1": { "type": "string" },
        "addressLine2": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "country": { "type": "string" },
        "pincode": { "type": "string" },
        "isDefault": { "type": "boolean" }
      },
      "required": ["fullName", "phone", "addressLine1", "city", "state", "country", "pincode", "isDefault"]
    }
  },
  "firestore": {
    "/users/{userId}/cart/{itemId}": {
      "schema": { "$ref": "#/entities/cartItems" },
      "description": "Shopping cart items for a user"
    },
    "/users/{userId}/wishlist/{productId}": {
      "schema": { "$ref": "#/entities/wishlistItems" },
      "description": "Wishlist items for a user"
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": { "$ref": "#/entities/addresses" },
      "description": "Saved addresses for a user"
    }
  }
}
